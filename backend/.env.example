# =============================================================================
# AI Career Intelligence Platform - BACKEND environment variables
# Copy to `.env` and fill in. NEVER commit the real `.env`.
#   Windows : copy .env.example .env
#   macOS/Linux: cp .env.example .env
# =============================================================================

# --- Application ------------------------------------------------------------
APP_ENV=development                 # development | production
DEBUG=true                          # true only in development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed frontend origins. In production set this to
# your real Vercel domain only, e.g. https://my-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- File upload limits -----------------------------------------------------
MAX_UPLOAD_SIZE_MB=200              # hard limit, request is rejected with 413
MIN_UPLOAD_SIZE_BYTES=1024          # anything smaller is treated as empty/corrupt
TEMP_DIR=                           # blank = OS temp dir. Uploads live here only
                                    # while being processed, then are deleted.
KEEP_TEMP_FILES=false               # true keeps converted audio for debugging

# --- FFmpeg -----------------------------------------------------------------
# Absolute paths only needed if ffmpeg/ffprobe are not on your PATH.
# Windows example: C:/ffmpeg/bin/ffmpeg.exe
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_TIMEOUT_SECONDS=900
AUDIO_SAMPLE_RATE=16000             # Whisper expects 16 kHz mono
AUDIO_CHANNELS=1

# --- Whisper ----------------------------------------------------------------
WHISPER_BACKEND=faster-whisper      # faster-whisper | openai
WHISPER_MODEL=base                  # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu                  # cpu | cuda
WHISPER_COMPUTE_TYPE=int8           # int8 | int8_float16 | float16 | float32
WHISPER_LANGUAGE=                   # blank = auto-detect, or e.g. en
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true             # drop long silences before transcribing

# =============================================================================
# AI PROVIDERS - multi-model fallback
#
#   Grok (xAI)  ->  Google Gemini  ->  Groq  ->  controlled error
#     PRIMARY        FALLBACK 1       FALLBACK 2
#
# Providers are tried ONE AT A TIME, in that order, and the chain STOPS at the
# first valid response. A provider with no API key is skipped without being
# called, so a normal analysis costs exactly one request. Set at least one key;
# setting all three is what makes the system survive a 401 or an exhausted
# free-tier quota. All three keys are BACKEND-ONLY and are never sent to React.
# =============================================================================

# --- Fallback behaviour -----------------------------------------------------
LLM_PROVIDER_ORDER=grok,gemini,groq  # fallback order. Unknown names are ignored.
LLM_PROVIDER_MAX_ATTEMPTS=2         # requests one provider may spend on one prompt.
                                    # Only transient faults (network/timeout/5xx)
                                    # retry; auth, quota and model errors never do.
                                    # Set to 1 to allow no retry at all.
LLM_SCHEMA_RETRY_ATTEMPTS=2         # corrective re-prompts when a provider returns
                                    # unusable JSON. 1 = strict minimum quota use.
LLM_TEMPERATURE=0.1                 # used by Gemini and Groq (Grok has its own below)

# --- Grok / xAI  (PRIMARY) --------------------------------------------------
# Get a key at https://console.x.ai  ->  API Keys
XAI_API_KEY=
XAI_MODEL=grok-4-fast               # e.g. grok-4-fast, grok-4.6
XAI_BASE_URL=https://api.x.ai/v1
XAI_TIMEOUT_SECONDS=120
XAI_MAX_RETRIES=3                   # legacy; capped by LLM_PROVIDER_MAX_ATTEMPTS
XAI_TEMPERATURE=0.1                 # low = factual, less invention

# --- Google Gemini  (FALLBACK 1) --------------------------------------------
# Get a key at https://aistudio.google.com/apikey  (free tier available).
# Leave GEMINI_API_KEY blank to skip Gemini entirely - it will not be called.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash       # gemini-2.0-flash | gemini-2.5-flash |
                                    # gemini-2.5-pro. The 2.5 models spend output
                                    # tokens on thinking, so keep the default
                                    # unless you know you need them.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=120

# --- Groq  (FALLBACK 2) -----------------------------------------------------
# Get a key at https://console.groq.com/keys  (free tier available).
# Leave GROQ_API_KEY blank to skip Groq entirely - it will not be called.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile  # any Groq model with JSON-mode support
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=120

# --- Transcript chunking (long meetings) ------------------------------------
LLM_CHUNK_CHAR_SIZE=9000            # ~2.2k tokens of transcript per chunk
LLM_CHUNK_OVERLAP_CHARS=600         # carry-over so sentences are not cut in half
LLM_MAX_CHUNKS=40                   # safety valve for enormous transcripts

# --- Supabase ---------------------------------------------------------------
# Project Settings -> Data API / API Keys
# SERVICE ROLE key stays on the BACKEND ONLY. Never put it in the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=public
SUPABASE_TIMEOUT_SECONDS=30
