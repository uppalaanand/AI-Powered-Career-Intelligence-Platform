# =============================================================================
# AI Career Intelligence Platform - BACKEND environment variables
# Copy to `.env` and fill in. NEVER commit the real `.env`.
#   Windows : copy .env.example .env
#   macOS/Linux: cp .env.example .env
# =============================================================================

# --- Application ------------------------------------------------------------
APP_ENV=development                 # development | production
DEBUG=true                          # true only in development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed frontend origins. In production set this to
# your real Vercel domain only, e.g. https://my-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- File upload limits -----------------------------------------------------
MAX_UPLOAD_SIZE_MB=200              # hard limit, request is rejected with 413
MIN_UPLOAD_SIZE_BYTES=1024          # anything smaller is treated as empty/corrupt
# blank = OS temp dir. Uploads live here only
# while being processed, then are deleted.
TEMP_DIR=
KEEP_TEMP_FILES=false               # true keeps converted audio for debugging

# --- FFmpeg -----------------------------------------------------------------
# Absolute paths only needed if ffmpeg/ffprobe are not on your PATH.
# Windows example: C:/ffmpeg/bin/ffmpeg.exe
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_TIMEOUT_SECONDS=900
AUDIO_SAMPLE_RATE=16000             # Whisper expects 16 kHz mono
AUDIO_CHANNELS=1

# --- Whisper ----------------------------------------------------------------
WHISPER_BACKEND=faster-whisper      # faster-whisper | openai
WHISPER_MODEL=base                  # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu                  # cpu | cuda
WHISPER_COMPUTE_TYPE=int8           # int8 | int8_float16 | float16 | float32
# blank = auto-detect, or e.g. en
WHISPER_LANGUAGE=
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true             # drop long silences before transcribing

# =============================================================================
# LLM - GROQ ONLY
#
# Groq (https://groq.com) is the application's ONLY LLM provider. It powers
# Milestone 2 (summary, key points, decisions, action items, participants,
# deadlines, priorities) and Milestone 3 (RAG answers). There is no fallback
# provider. The key is BACKEND-ONLY and is never sent to React.
#
# NOTE: Groq (the inference platform) is not Grok (xAI's model). xAI Grok and
# Google Gemini were removed from this project.
# =============================================================================

# Get a key at https://console.groq.com/keys (free tier available).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b       # or llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_ATTEMPTS=2                 # requests per prompt on transient errors (network,
                                    # 5xx). 1 = never retry. Auth/model/quota errors
                                    # are never retried.
GROQ_TEMPERATURE=0.1                # low = factual, less invention
GROQ_REASONING_EFFORT=low           # only sent to reasoning models (openai/gpt-oss-*,
                                    # qwen/qwen3-*). "low" saves reasoning tokens.
                                    # Blank = never send it.
GROQ_MAX_RATE_LIMIT_WAIT_SECONDS=20 # on HTTP 429, wait and retry ONCE only if Groq
                                    # asks for at most this long; otherwise fail fast

# --- Token budget (keeps requests inside a free Groq plan's limits) ---------
LLM_SCHEMA_RETRY_ATTEMPTS=2         # corrective re-prompts for invalid JSON (1 = none)
LLM_CHUNK_CONCURRENCY=1             # chunks of a long transcript analysed at once
LLM_MAX_OUTPUT_TOKENS=3000          # single-pass analysis and merge
LLM_CHUNK_MAX_OUTPUT_TOKENS=2000    # each chunk of a long transcript
LLM_MAX_REQUEST_TOKENS=7000         # prompt + output ceiling for one request; a
                                    # chunk-merge that would exceed it is done locally

# --- Transcript chunking (long meetings) ------------------------------------
LLM_CHUNK_CHAR_SIZE=9000            # ~2.2k tokens of transcript per chunk
LLM_CHUNK_OVERLAP_CHARS=600         # carry-over so sentences are not cut in half
LLM_MAX_CHUNKS=40                   # safety valve for enormous transcripts

# =============================================================================
# MILESTONE 3 - MEETING KNOWLEDGE SEARCH (embeddings + vector database)
#
#   Supabase meetings -> knowledge documents -> embeddings -> Pinecone
#                     -> semantic search -> RAG answers (via Groq, above)
#
# Optional: leave PINECONE_API_KEY blank and Milestones 1 and 2 work exactly
# as before - only the "Ask & search" page is unavailable. The key is
# BACKEND-ONLY and is never sent to React.
# =============================================================================

# --- Embeddings (LOCAL - no API key, no quota) -----------------------------
# Embeddings are computed on the backend with fastembed (ONNX Runtime, no
# PyTorch). Groq does not produce embeddings. The SAME model embeds stored
# passages and search queries. The model (~67 MB) downloads on first use.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384            # MUST match the model AND the Pinecone index
EMBEDDING_BATCH_SIZE=32
# blank = OS temp dir. In production set a
# persistent path so restarts skip the download
EMBEDDING_CACHE_DIR=
# blank = ONNX Runtime default
EMBEDDING_THREADS=
EMBEDDING_PRELOAD=true              # warm the model in the background at startup

# --- Knowledge chunking -----------------------------------------------------
# Smaller than the analysis chunks above: retrieval wants a precise passage,
# not a whole section of the meeting.
KNOWLEDGE_CHUNK_CHAR_SIZE=1200
KNOWLEDGE_CHUNK_OVERLAP_CHARS=150
KNOWLEDGE_MAX_CHUNKS_PER_MEETING=200
KNOWLEDGE_MAX_BACKFILL_MEETINGS=200 # ceiling for one POST /api/knowledge/index run
KNOWLEDGE_AUTO_INDEX=true           # index a meeting once its AI analysis succeeds

# --- Pinecone (vector database) ---------------------------------------------
# Create a free account at https://app.pinecone.io -> API Keys.
# The index is created automatically on first use with the dimension above;
# create it yourself instead if you prefer (metric: cosine).
PINECONE_API_KEY=
PINECONE_INDEX_NAME=meeting-knowledge
PINECONE_NAMESPACE=meetings
# blank = looked up once and cached
PINECONE_INDEX_HOST=
PINECONE_TIMEOUT_SECONDS=30
PINECONE_MAX_ATTEMPTS=2
PINECONE_CLOUD=aws                  # only used when creating the index
PINECONE_REGION=us-east-1           # only used when creating the index
PINECONE_CREATE_INDEX_IF_MISSING=true

# --- Search and RAG behaviour -----------------------------------------------
SEARCH_DEFAULT_TOP_K=8              # passages retrieved per search
SEARCH_MAX_TOP_K=50
SEARCH_MIN_SCORE=0.0                # drop matches below this similarity (0-1)
RAG_TOP_K=12                        # passages retrieved as answer context
RAG_MAX_CONTEXT_CHARS=12000         # hard ceiling on context sent to the LLM
RAG_MAX_MEETINGS_IN_CONTEXT=6

# --- Supabase ---------------------------------------------------------------
# Project Settings -> Data API / API Keys
# SERVICE ROLE key stays on the BACKEND ONLY. Never put it in the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=public
SUPABASE_TIMEOUT_SECONDS=30
