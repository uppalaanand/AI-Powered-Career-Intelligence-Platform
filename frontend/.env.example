# =============================================================================
# AI Career Intelligence Platform - FRONTEND environment variables
# Copy to `.env` and adjust. Only VITE_* variables reach the browser.
#
# NEVER put the Supabase service-role key or any AI provider key (XAI_API_KEY,
# GEMINI_API_KEY, GROQ_API_KEY) in this file. They are backend-only.
# Everything here is public once the app is built.
# =============================================================================

# Base URL of the FastAPI backend.
# Local development: leave blank to use the Vite proxy (/api -> localhost:8000).
# Production (Vercel): set the full URL of your deployed backend, e.g.
#   VITE_API_BASE_URL=https://your-backend.onrender.com
VITE_API_BASE_URL=

# Request timeout in milliseconds. Transcription is slow, so this is generous.
VITE_API_TIMEOUT_MS=900000

# Only used by `npm run dev`: where the Vite proxy forwards /api requests.
VITE_DEV_PROXY_TARGET=http://localhost:8000
